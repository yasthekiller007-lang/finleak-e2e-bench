# Copy to frontend/.env.local. All values below are server-side.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional provider-specific API audience request parameter (e.g. Auth0).
OIDC_AUDIENCE=
# Optional scopes for providers that select the API through scopes; include openid.
OIDC_SCOPES=openid profile email
BACKEND_URL=http://127.0.0.1:8000
FLA_MAX_UPLOAD_BYTES=20971520
