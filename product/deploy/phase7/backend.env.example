# Protected staging-only values, never committed credentials. No production instance exists.
FLA_ENVIRONMENT=production
FLA_RELEASE_SHA=
FLA_DATABASE_URL=
# URL requires postgresql+psycopg and sslmode=verify-full plus provider CA trust.
FLA_DATABASE_POOL_SIZE=5
FLA_DATABASE_MAX_OVERFLOW=0
FLA_DATABASE_POOL_TIMEOUT_SECONDS=5
FLA_PUBLIC_APP_URL=
FLA_CORS_ORIGINS=[]
# Include the exact private ingress Host and health probe host approved for the network.
FLA_ALLOWED_HOSTS=[]
FLA_STORAGE_BACKEND=s3
FLA_S3_ENDPOINT_URL=
FLA_S3_BUCKET=
FLA_S3_REGION=
# Prefer approved workload credentials; explicit key pairs are protected runtime secrets.
FLA_S3_ACCESS_KEY_ID=
FLA_S3_SECRET_ACCESS_KEY=
FLA_SCANNER_BACKEND=clamav
FLA_SCANNER_HOST=
FLA_SCANNER_PORT=3310
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
FLA_LOG_LEVEL=INFO
