# Copy to .env; enter a password used only for your local PostgreSQL instance.
POSTGRES_USER=financial_leakage
POSTGRES_DB=financial_leakage
POSTGRES_PASSWORD=
# Substitute the local user/password above; URL-encode special characters.
FLA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/financial_leakage
FLA_ENVIRONMENT=development
FLA_CORS_ORIGINS=["http://localhost:3000"]
FLA_STORAGE_ROOT=.local/documents
FLA_LOG_LEVEL=INFO
FLA_DATABASE_TIMEOUT_SECONDS=5
FLA_MAX_UPLOAD_BYTES=20971520
# Real OIDC provider configuration; API access tokens must have this audience.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Server-only Next.js backend address; never exposed in browser configuration.
BACKEND_URL=http://127.0.0.1:8000
# Optional asymmetric JWT algorithms (JSON list); never accepts HMAC or unsigned JWTs.
OIDC_SIGNING_ALGORITHMS=["RS256"]

# Candidate processing limits (JSON). No live AI provider/key is required.
FLA_PROCESSING_LIMITS={"max_pages":100,"max_rows":5000,"max_cells":50000,"max_characters":500000,"max_fields":5000,"timeout_seconds":20,"memory_mb":512,"max_zip_bytes":52428800,"scanned_text_threshold":60}
FLA_MAX_EXTRACTION_ATTEMPTS=10
